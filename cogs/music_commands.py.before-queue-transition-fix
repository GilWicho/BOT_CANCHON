    @commands.command(name="play", aliases=["p", "reproducir"])
    @commands.guild_only()
    @commands.cooldown(2, 5, commands.BucketType.guild)
    async def play(self, ctx: commands.Context, *, query: str) -> None:
        """Reproduce un enlace o busca una canción por nombre en YouTube."""
        player = await self.get_player(ctx, connect=True)
        if player is None:
            return

        if player.queue.count >= self.max_queue:
            await ctx.send(f"La cola alcanzó el límite de {self.max_queue} canciones.")
            return

        async with ctx.typing():
            try:
                results = await self.search(query)
            except TimeoutError:
                await ctx.send("La búsqueda tardó demasiado. Intenta otra vez.")
                return
            except wavelink.LavalinkLoadException as error:
                await ctx.send(f"No pude cargar esa música: `{error}`")
                return

        available = self.max_queue - player.queue.count

        # Consultar a Lavalink directamente, porque player.current puede
        # quedar desincronizado cuando una pista falla o es iniciada por REST.
        try:
            remote_player = await player.node.fetch_player_info(ctx.guild.id)
        except Exception as error:
            print(
                f"[PLAY] No pude consultar el estado real de Lavalink: {error}",
                flush=True,
            )
            remote_player = None

        remote_track = remote_player.track if remote_player else None
        lavalink_is_playing = remote_track is not None

        print(
            "[PLAY] "
            f"Track local: "
            f"{player.current.title if player.current else None} | "
            f"Track real: "
            f"{remote_track.title if remote_track else None}",
            flush=True,
        )

        if isinstance(results, wavelink.Playlist):
            selected = list(results.tracks[:available])

            if not selected:
                await ctx.send("La playlist no contiene canciones reproducibles.")
                return

            self.apply_requester(selected, ctx.author)

            if not lavalink_is_playing:
                first_track = selected[0]
                remaining_tracks = selected[1:]

                await self.play_minimal(player, first_track)

                if remaining_tracks:
                    await player.queue.put_wait(remaining_tracks)

                await ctx.send(
                    f"Reproduciendo: {track_label(first_track)}\n"
                    f"{len(remaining_tracks)} canción(es) quedaron en la cola."
                )
            else:
                added = await player.queue.put_wait(selected)
                truncated = len(results.tracks) > added
                suffix = (
                    " (limitada por el tamaño máximo de la cola)"
                    if truncated
                    else ""
                )

                await ctx.send(
                    f"Playlist "
                    f"**{discord.utils.escape_markdown(results.name)}**: "
                    f"{added} canción(es) agregadas{suffix}."
                )

        else:
            if not results:
                await ctx.send("No encontré resultados para esa búsqueda.")
                return

            track = results[0]
            self.apply_requester([track], ctx.author)

            if not lavalink_is_playing:
                await self.play_minimal(player, track)

                await ctx.send(f"Reproduciendo: {track_label(track)}")
            else:
                await player.queue.put_wait(track)
                await ctx.send(f"Agregada a la cola: {track_label(track)}")

    @play.error
    async def play_error(
        self, ctx: commands.Context, error: commands.CommandError
    ) -> None:
        if isinstance(error, commands.MissingRequiredArgument):
            await ctx.send(
                f"Uso: `{ctx.clean_prefix}play <nombre o enlace>`\n"
                f"Para buscar directamente en YouTube: "
                f"`{ctx.clean_prefix}play yt:<nombre>`"
            )
            return
        if isinstance(error, commands.CommandOnCooldown):
            await ctx.send("Espera unos segundos antes de hacer otra búsqueda.")
            return
        raise error

